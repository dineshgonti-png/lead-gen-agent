# ── LinkedIn Credentials ──────────────────────────────
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password

# ── Browser Settings ─────────────────────────────────
HEADLESS=true
CHROME_BINARY=
CHROMEDRIVER_PATH=
PAGE_LOAD_TIMEOUT=30
IMPLICIT_WAIT=10

# ── Rate Limiting ────────────────────────────────────
REQUEST_DELAY_MIN=3
REQUEST_DELAY_MAX=7
BATCH_PAUSE=30

# ── Contacts ─────────────────────────────────────────
MAX_CONTACTS_PER_COMPANY=10
MIN_CONTACTS_THRESHOLD=3

# ── Output ───────────────────────────────────────────
OUTPUT_CSV_NAME=stakeholders_{timestamp}.csv
